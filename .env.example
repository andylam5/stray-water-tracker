# Get a key at https://aistudio.google.com/apikey and copy this file to .env
GEMINI_API_KEY=
# Optional: override the model used for Stray's weekly read
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: most Gemini calls per UTC day across all users (cached reads don't count)
# GEMINI_DAILY_LIMIT=500
# Set to 1 when deployed behind a host's proxy (Render, Railway, Fly…) so rate limits are per user
# TRUST_PROXY=1
# Port for `npm start` (hosts usually set this for you)
# PORT=3000
